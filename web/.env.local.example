# Copy this to .env.local and fill in your values from Supabase project settings

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this to the browser (no NEXT_PUBLIC_ prefix)
# Used only in API routes for admin operations (invite / delete users)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
